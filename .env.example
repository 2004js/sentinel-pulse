# ------------------------------------------------------------------
# Frontend (Vite)
# ------------------------------------------------------------------
VITE_SENTINEL_API_URL=http://localhost:8000
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# true = local SIH demo auth, false = Supabase Auth in production
VITE_DEMO_AUTH=true

# ------------------------------------------------------------------
# Backend
# ------------------------------------------------------------------
APP_ENV=development
DATABASE_URL=sqlite:///./sentinel_pulse.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DEMO_AUTH_ENABLED=true

# Required for demo session signing when DEMO_AUTH_ENABLED=true
SENTINEL_SESSION_SECRET=replace-with-a-long-random-32-byte-secret

# Production Supabase Auth JWT verification
SUPABASE_URL=
SUPABASE_JWT_AUDIENCE=authenticated
# Optional only for legacy HS256 Supabase projects; prefer JWKS/ES256.
SUPABASE_JWT_SECRET=

# Production encryption key: base64url encoding of exactly 32 random bytes.
SENTINEL_ENCRYPTION_KEY_B64=
SENTINEL_HASH_SALT=replace-with-a-long-random-secret

# Demo credentials — change or remove in production.
SENTINEL_WELFARE_PASSWORD=Sentinel@123
SENTINEL_COMMANDER_PASSWORD=Sentinel@123
SENTINEL_PERSONNEL_PASSWORD=Sentinel@123

# Optional
FORCE_PERSONNEL_COVERED=1284
SEED_DEMO_DATA=true
ENABLE_SWAGGER=true
LOG_LEVEL=INFO
